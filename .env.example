# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (with DB_ prefix)
# Production Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=task_user
DB_PASSWORD=task_password_2024
DB_NAME=task_db
DB_SSL=false

# Alternative Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=sports_user
# DB_PASSWORD=sports_password_2024
# DB_NAME=sports_admin
# DB_SSL=false

# Database Pool Configuration
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000

# Redis (with REDIS_ prefix)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5000
REDIS_LAZY_CONNECT=3000
REDIS_RETRY_DELAY_ON_FAILOVER=3
CACHE_TTL=3600000

# BullMQ queue Redis (separate from the cache Redis above)
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=Backend template API
SWAGGER_VERSION=1.0.0

# Seeders (yarn seed:users)
SEEDER_USER_COUNT=50
SEEDER_CLEAR_EXISTING=true
SEEDER_VERBOSE_LOGGING=true
SEEDER_BATCH_SIZE=10
SEEDER_ENVIRONMENT=development

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Admin Seeder (yarn seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
# Required in production. Falls back to Admin@12345 in development.
ADMIN_PASSWORD=
# Set true to overwrite the password of an already existing admin
ADMIN_FORCE_RESET=false

# Storage (file uploads)
# Which backend files are written to: local | s3 | appwrite
# Defaults to `local` in development. Must be set explicitly when
# NODE_ENV=production — the app refuses to boot otherwise.
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE=10485760
# Comma-separated MIME allow-list. Empty accepts any type.
STORAGE_ALLOWED_MIME_TYPES=
# Seconds a signed URL stays valid (s3 / appwrite)
STORAGE_URL_EXPIRES_IN=900

# --- local driver ---
STORAGE_LOCAL_ROOT=./storage/uploads
# Public base URL mapping to STORAGE_LOCAL_ROOT, required by GET /files/:id/url.
# Required when NODE_ENV=production and STORAGE_DRIVER=local.
STORAGE_LOCAL_BASE_URL=

# --- s3 driver (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces, Wasabi) ---
# docker-compose reads these same vars to provision the local MinIO and its
# bucket, so one set of values configures both sides.
# For the bundled MinIO (`docker compose up -d minio`), use:
#   STORAGE_DRIVER=s3
#   STORAGE_S3_BUCKET=uploads
#   STORAGE_S3_ACCESS_KEY_ID=minioadmin
#   STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
#   STORAGE_S3_ENDPOINT=http://localhost:9000
#   STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Leave empty for real AWS S3; set for S3-compatible providers
STORAGE_S3_ENDPOINT=
# Required by MinIO and most self-hosted gateways
STORAGE_S3_FORCE_PATH_STYLE=false
# Bucket read access: private | public
# private -> GET /files/:id/url returns a presigned URL that expires
# public  -> permanent, cacheable URL (right for avatars and other public assets)
# docker-compose applies the matching bucket policy from this same value.
STORAGE_S3_VISIBILITY=private
# Base URL clients use to reach the bucket, when it differs from
# STORAGE_S3_ENDPOINT (phones cannot resolve localhost or a docker hostname).
# Empty reuses STORAGE_S3_ENDPOINT.
STORAGE_S3_PUBLIC_ENDPOINT=

# --- appwrite driver ---
STORAGE_APPWRITE_ENDPOINT=
STORAGE_APPWRITE_PROJECT_ID=
STORAGE_APPWRITE_API_KEY=
STORAGE_APPWRITE_BUCKET_ID=

# Localization (i18n)
# Language used when the client sends nothing or an unsupported code
I18N_FALLBACK_LANGUAGE=en
# Request header carrying the language code, e.g. `x-lang: bn`
I18N_HEADER_NAME=x-lang
I18N_SUPPORTED_LANGUAGES=en,bn
# Reload locale files on change (development convenience)
I18N_WATCH=false
