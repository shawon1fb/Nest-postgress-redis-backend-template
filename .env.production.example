# Production environment for the Docker image.
#
#   cp .env.production.example .env.production   # then fill in the secrets
#   yarn docker:run
#
# .env.production is gitignored. Never commit real credentials.
#
# Hostnames below are docker-compose service names, which resolve when the
# container runs on the same network (that is what `yarn docker:run` does).
# Deploying elsewhere means replacing them with real hosts.

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# --- Database ---------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=task_user
DB_PASSWORD=CHANGE_ME
DB_NAME=task_db
DB_SSL=false

# --- Redis (cache) ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_TTL=3600000

# --- Redis (BullMQ queues) --------------------------------------------------
BULLMQ_REDIS_HOST=redis-bullmq
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Rate limiting ----------------------------------------------------------
# Counters are per PM2 worker while throttler storage is in memory.
# Keep PM2_INSTANCES=1 or move the storage to Redis before scaling out.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- API docs ---------------------------------------------------------------
# Leave disabled unless the docs are meant to be public.
SWAGGER_ENABLED=false

# --- Storage ----------------------------------------------------------------
# Required explicitly in production: the app refuses to boot without it.
STORAGE_DRIVER=s3
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_MIME_TYPES=
STORAGE_URL_EXPIRES_IN=900

STORAGE_S3_BUCKET=uploads
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME
STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_VISIBILITY=private
# Address clients use, when it differs from the internal endpoint above.
STORAGE_S3_PUBLIC_ENDPOINT=

# --- Localization -----------------------------------------------------------
I18N_FALLBACK_LANGUAGE=en
I18N_HEADER_NAME=x-lang
I18N_SUPPORTED_LANGUAGES=en,bn
I18N_WATCH=false

# --- PM2 --------------------------------------------------------------------
PM2_INSTANCES=1
PM2_MAX_MEMORY=512M
